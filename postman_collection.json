{
  "info": {
    "name": "SGroup Backend E-Commerce API (2026)",
    "_postman_id": "a90df1a5-291b-4cd3-8991-382a1768f789",
    "description": "Bộ sưu tập kiểm thử RESTful API hoàn chỉnh cho Đồ án cuối khóa SGroup Backend Basic 2026.\nBao gồm đầy đủ các luồng: Auth, User, Categories, Products (Redis Cache), Orders (Database Transaction), Admin Management và Upload Cloudinary.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api",
      "type": "string"
    },
    {
      "key": "userToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "adminToken",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01. Authentication & System",
      "item": [
        {
          "name": "0. Health Check (Server Root)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:3000/",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": [""]
            }
          }
        },
        {
          "name": "1. Đăng ký tài khoản User mới",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Trần Văn Tân\",\n  \"email\": \"tan@gmail.com\",\n  \"password\": \"User@123\",\n  \"phone\": \"0988776655\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            }
          }
        },
        {
          "name": "2. Đăng nhập User (Tự động lưu Token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.success && res.data && res.data.token) {",
                  "    pm.collectionVariables.set('userToken', res.data.token);",
                  "    console.log('✅ Đã lưu userToken:', res.data.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@gmail.com\",\n  \"password\": \"User@123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "3. Đăng nhập Admin (Tự động lưu Token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.success && res.data && res.data.token) {",
                  "    pm.collectionVariables.set('adminToken', res.data.token);",
                  "    console.log('✅ Đã lưu adminToken:', res.data.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@gmail.com\",\n  \"password\": \"Admin@123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "4. Lấy thông tin tài khoản hiện tại (Get Me)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{userToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "me"]
            }
          }
        }
      ]
    },
    {
      "name": "02. User Profile & Avatar",
      "item": [
        {
          "name": "1. Xem thông tin cá nhân",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{userToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/users/profile",
              "host": ["{{baseUrl}}"],
              "path": ["users", "profile"]
            }
          }
        },
        {
          "name": "2. Cập nhật họ tên & SĐT",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{userToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Nguyễn Văn Khách Hàng VIP\",\n  \"phone\": \"0988112233\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/users/profile",
              "host": ["{{baseUrl}}"],
              "path": ["users", "profile"]
            }
          }
        },
        {
          "name": "3. Upload Avatar lên Cloudinary (Multer Form-Data)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{userToken}}" }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "avatar",
                  "type": "file",
                  "src": []
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/users/profile/avatar",
              "host": ["{{baseUrl}}"],
              "path": ["users", "profile", "avatar"]
            }
          }
        },
        {
          "name": "4. Admin xem danh sách toàn bộ Users",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/users?page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["users"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "03. Categories",
      "item": [
        {
          "name": "1. Lấy danh sách danh mục (Công khai)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/categories",
              "host": ["{{baseUrl}}"],
              "path": ["categories"]
            }
          }
        }
      ]
    },
    {
      "name": "04. Products & Redis Cache",
      "item": [
        {
          "name": "1. Lấy danh sách sản phẩm (Test Redis Cache)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products?page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["products"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "2. Tìm kiếm sản phẩm theo tên & Danh mục",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products?search=pro&categoryId=1",
              "host": ["{{baseUrl}}"],
              "path": ["products"],
              "query": [
                { "key": "search", "value": "pro" },
                { "key": "categoryId", "value": "1" }
              ]
            }
          }
        },
        {
          "name": "3. Lấy chi tiết sản phẩm theo ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products/1",
              "host": ["{{baseUrl}}"],
              "path": ["products", "1"]
            }
          }
        },
        {
          "name": "4. Admin thêm sản phẩm mới (Tự xóa Cache)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"iPad Mini 6 Wi-Fi 64GB\",\n  \"description\": \"Thiết kế nhỏ gọn 8.3 inch, chip A15 Bionic mạnh mẽ\",\n  \"price\": 12990000,\n  \"stock\": 15,\n  \"categoryId\": 3,\n  \"imageUrl\": \"https://images.unsplash.com/photo-1544244015-0df4b3ffc6b0?w=600\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/products",
              "host": ["{{baseUrl}}"],
              "path": ["products"]
            }
          }
        },
        {
          "name": "5. Admin cập nhật thông tin sản phẩm",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"iPhone 15 Pro Max 256GB (Giảm giá sốc)\",\n  \"price\": 28990000\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/products/1",
              "host": ["{{baseUrl}}"],
              "path": ["products", "1"]
            }
          }
        },
        {
          "name": "6. Admin cập nhật tồn kho (Stock)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"stock\": 50\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/products/1/stock",
              "host": ["{{baseUrl}}"],
              "path": ["products", "1", "stock"]
            }
          }
        },
        {
          "name": "7. Admin upload ảnh sản phẩm lên Cloudinary",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "image",
                  "type": "file",
                  "src": []
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/products/1/image",
              "host": ["{{baseUrl}}"],
              "path": ["products", "1", "image"]
            }
          }
        },
        {
          "name": "8. Admin vô hiệu hóa sản phẩm (Soft Delete)",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/products/8",
              "host": ["{{baseUrl}}"],
              "path": ["products", "8"]
            }
          }
        }
      ]
    },
    {
      "name": "05. Orders & Transactions (User)",
      "item": [
        {
          "name": "1. User đặt hàng mới (Transaction + Trừ kho)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{userToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    { \"productId\": 1, \"quantity\": 2 },\n    { \"productId\": 6, \"quantity\": 1 }\n  ],\n  \"shippingAddress\": \"123 Lê Duẩn, Quận Hải Châu, Đà Nẵng\",\n  \"phone\": \"0987654321\",\n  \"note\": \"Giao hàng giờ hành chính giúp mình\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/orders",
              "host": ["{{baseUrl}}"],
              "path": ["orders"]
            }
          }
        },
        {
          "name": "2. User xem danh sách đơn hàng của mình",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{userToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/orders/my-orders?page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["orders", "my-orders"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "3. User xem chi tiết đơn hàng của mình",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{userToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/orders/my-orders/1",
              "host": ["{{baseUrl}}"],
              "path": ["orders", "my-orders", "1"]
            }
          }
        },
        {
          "name": "4. User hủy đơn hàng PENDING (Hoàn tồn kho)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{userToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/orders/my-orders/3/cancel",
              "host": ["{{baseUrl}}"],
              "path": ["orders", "my-orders", "3", "cancel"]
            }
          }
        }
      ]
    },
    {
      "name": "06. Admin Order Management",
      "item": [
        {
          "name": "1. Admin xem toàn bộ đơn hàng trong hệ thống",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/orders/admin?page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["orders", "admin"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" }
              ]
            }
          }
        },
        {
          "name": "2. Admin lọc đơn theo trạng thái (status=PENDING)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/orders/admin?status=PENDING",
              "host": ["{{baseUrl}}"],
              "path": ["orders", "admin"],
              "query": [
                { "key": "status", "value": "PENDING" }
              ]
            }
          }
        },
        {
          "name": "3. Admin xem chi tiết bất kỳ đơn hàng nào",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/orders/admin/1",
              "host": ["{{baseUrl}}"],
              "path": ["orders", "admin", "1"]
            }
          }
        },
        {
          "name": "4. Admin chuyển trạng thái sang SHIPPING",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"SHIPPING\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/orders/admin/3/status",
              "host": ["{{baseUrl}}"],
              "path": ["orders", "admin", "3", "status"]
            }
          }
        },
        {
          "name": "5. Admin chuyển trạng thái sang DELIVERED (Hoàn tất)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"DELIVERED\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/orders/admin/2/status",
              "host": ["{{baseUrl}}"],
              "path": ["orders", "admin", "2", "status"]
            }
          }
        }
      ]
    }
  ]
}
